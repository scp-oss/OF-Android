<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_sheet_grip" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/connection_settings"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/ink" />

            <ImageButton
                android:id="@+id/closeSettings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_icon_btn"
                android:src="@drawable/ic_close"
                app:tint="@color/ink"
                android:scaleType="center"
                android:contentDescription="@string/close" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_shared_hint"
            android:textSize="11sp"
            android:textColor="@color/ink_faint"
            android:layout_marginTop="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/socks_port"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/ink_muted"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/socksPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface_input"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/ink"
            android:inputType="number"
            android:paddingHorizontal="12dp"
            android:paddingVertical="11dp"
            android:maxLines="1"
            tools:text="10808" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_surface_row"
            android:padding="14dp"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/udp_quic_label"
                    android:textSize="13.5sp"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/udp_quic_hint"
                    android:textSize="11.5sp"
                    android:textColor="@color/ink_muted"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchUdp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:trackTint="@color/switch_track_tint"
                app:thumbTint="@color/switch_thumb_tint" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnDnsSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_button_outlined"
            android:paddingVertical="12dp"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dns_settings_open"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ink" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_not_wired_hint"
            android:textSize="10.5sp"
            android:textColor="@color/ink_faint"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_button_primary"
            android:paddingVertical="12dp"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save_settings"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/accent_ink" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnEmailLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_button_outlined"
            android:paddingVertical="12dp"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/email_logs_title"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ink" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnAboutOpen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:layout_marginTop="4dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about_app"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ink_muted" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
